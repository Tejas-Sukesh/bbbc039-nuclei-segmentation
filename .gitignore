# Dataset — downloaded via scripts/download_data.sh, never committed (~80 MB)
data/

# Outputs. The bulky per-object dumps are regenerable and stay out, but the
# summaries and per-image rows the writeup quotes are committed: a number in the
# README that cannot be checked against the file that produced it is an
# assertion, not a result.
results/**
!results/.gitkeep
!results/*_summary.json
!results/*_per_image.csv
!results/bandit_sweep_*.json
!results/tta_comparison_*.json
!results/flowcache_benchmark.json
!results/failures_*_missed_objects.csv
!results/failures_*_merged_predictions.csv

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# OS / editor
.DS_Store
__MACOSX/
.vscode/
.idea/

# Cached Cellpose network outputs (regenerable, large)
data/flow_cache/
